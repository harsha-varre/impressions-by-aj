# ── Enquiry email delivery ──────────────────────────────────────────────
# Where studio enquiries are delivered (your inbox)
STUDIO_EMAIL=impressionsbyaj21@gmail.com

# Option A (preferred): send through your Gmail.
# Turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste the 16 chars below
# (spaces optional). GMAIL_USER is the Gmail address that sends/receives.
GMAIL_USER=impressionsbyaj21@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Option B (fallback): Resend. Only used if the Gmail vars above are unset.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Public canonical URL (no trailing slash), used for metadata, OG and sitemap
NEXT_PUBLIC_SITE_URL=https://impressions-by-aj.vercel.app

# ── Supabase — admin login + photo storage (see SETUP.md) ───────────────
# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# "anon" public key (safe to expose)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# "service_role" secret key — SERVER ONLY, never expose. Enables uploads/deletes.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
